pipeline {
  agent {
    kubernetes {
      label "kaniko-${env.BUILD_NUMBER}"
      defaultContainer 'jnlp'
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  restartPolicy: Never
  volumes:
    - name: docker-config
      emptyDir: {}
  containers:
    - name: awscli
      image: amazon/aws-cli:2.15.57
      command: ['sh', '-c', 'cat']
      tty: true
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker

    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ['sh', '-c', 'cat']
      tty: true
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker

    - name: tools
      image: alpine:3.19
      command: ['sh', '-c', 'cat']
      tty: true
"""
    }
  }

  environment {
    AWS_REGION   = "eu-central-1"

    ECR_REGISTRY = "209578578085.dkr.ecr.eu-central-1.amazonaws.com"
    ECR_REPO     = "209578578085.dkr.ecr.eu-central-1.amazonaws.com/django-app"

    // де лежить values.yaml з image.tag у фінальному репо
    VALUES_FILE  = "Project/charts/django-app/values.yaml"
  }

  stages {
    stage('Checkout repo') {
      steps {
        checkout scm
        script {
          def sha = sh(script: 'git rev-parse --short=8 HEAD', returnStdout: true).trim()
          env.IMAGE_TAG = "build-${env.BUILD_NUMBER}-${sha}"
          echo "Computed IMAGE_TAG=${env.IMAGE_TAG}"
        }
      }
    }

    stage('Detect Docker build paths') {
      steps {
        container('tools') {
          sh '''
            set -e
            echo "Top-level listing:"
            ls -la

            echo "Project/ listing (if exists):"
            ls -la Project || true

            if [ -f "Project/Dockerfile" ]; then
              echo "Using Project"
              echo "APP_CONTEXT=Project" > build.env
              echo "DOCKERFILE=Project/Dockerfile" >> build.env
            elif [ -f "Project/Django/Dockerfile" ]; then
              echo "Using Project/Django"
              echo "APP_CONTEXT=Project/Django" > build.env
              echo "DOCKERFILE=Project/Django/Dockerfile" >> build.env
            elif [ -f "Django/Dockerfile" ]; then
              echo "Using Django"
              echo "APP_CONTEXT=Django" > build.env
              echo "DOCKERFILE=Django/Dockerfile" >> build.env
            else
              echo "ERROR: Dockerfile not found."
              find . -maxdepth 4 -name Dockerfile -print || true
              exit 1
            fi

            echo "Chosen build paths:"
            cat build.env
          '''
        }
        script {
          def envFile = readFile('build.env').trim().split('\n')
          envFile.each { line ->
            def (k, v) = line.split('=', 2)
            env."${k}" = v
          }
          echo "APP_CONTEXT=${env.APP_CONTEXT}"
          echo "DOCKERFILE=${env.DOCKERFILE}"
        }
      }
    }

    stage('Login to ECR (prepare docker config for Kaniko)') {
      steps {
        container('awscli') {
          withCredentials([
            string(credentialsId: 'aws_access_key_id', variable: 'AWS_ACCESS_KEY_ID'),
            string(credentialsId: 'aws_secret_access_key', variable: 'AWS_SECRET_ACCESS_KEY')
          ]) {
            sh '''
              set -e
              aws sts get-caller-identity

              PASS="$(aws ecr get-login-password --region ${AWS_REGION})"
              AUTH="$(printf "AWS:%s" "$PASS" | base64 | tr -d '\\n')"

              cat > /kaniko/.docker/config.json <<EOF
              {
                "auths": {
                  "${ECR_REGISTRY}": { "auth": "${AUTH}" },
                  "https://${ECR_REGISTRY}": { "auth": "${AUTH}" }
                }
              }
EOF
              echo "Docker config prepared for ${ECR_REGISTRY}"
            '''
          }
        }
      }
    }

    stage('Build & Push image to ECR (Kaniko)') {
      steps {
        container('kaniko') {
          sh '''
            set -e
            echo "Build context: ${WORKSPACE}/${APP_CONTEXT}"
            echo "Dockerfile:     ${WORKSPACE}/${DOCKERFILE}"
            ls -la "${WORKSPACE}/${APP_CONTEXT}"

            echo "Pushing:"
            echo "  ${ECR_REPO}:${IMAGE_TAG}"
            echo "  ${ECR_REPO}:latest"

            /kaniko/executor \
              --context "${WORKSPACE}/${APP_CONTEXT}" \
              --dockerfile "${WORKSPACE}/${DOCKERFILE}" \
              --destination "${ECR_REPO}:${IMAGE_TAG}" \
              --destination "${ECR_REPO}:latest"
          '''
        }
      }
    }

    stage('Update values.yaml in this repo (image.tag) and push to final-project') {
      steps {
        container('tools') {
          withCredentials([usernamePassword(
            credentialsId: 'github-pat-devops-course',
            usernameVariable: 'GITHUB_USER',
            passwordVariable: 'GITHUB_TOKEN'
          )]) {
            sh '''
              set -e
              apk add --no-cache git ca-certificates

              # Jenkins часто робить checkout у detached HEAD, тому явно створюємо/оновлюємо local branch final-project
              git checkout -B final-project

              # Перевірка що файл існує. Якщо ні, покажемо що є у charts.
              if [ ! -f "${VALUES_FILE}" ]; then
                echo "ERROR: ${VALUES_FILE} not found."
                echo "Available values.yaml under Project/charts:"
                find Project/charts -maxdepth 4 -name values.yaml -print || true
                exit 1
              fi

              echo "Updating ${VALUES_FILE} -> image.tag=${IMAGE_TAG}"

              # Дуже базово, але працює: замінюємо перший рядок з 'tag:' (з відступами)
              # Якщо у тебе інша структура values.yaml, тоді підлаштуємо sed під фактичний файл.
              sed -i "0,/^[[:space:]]*tag:[[:space:]]*/s//  tag: \\"${IMAGE_TAG}\\"/" "${VALUES_FILE}"

              echo "Result preview:"
              grep -n "repository:\\|tag:" "${VALUES_FILE}" || true

              git config user.email "jenkins@local"
              git config user.name "jenkins"

              git add "${VALUES_FILE}"
              git commit -m "chore: deploy ${IMAGE_TAG}" || echo "No changes to commit"

              # Пушимо в цей же репозиторій devops-course у гілку final-project через PAT
              git remote set-url origin "https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/MaRo-Christmas/devops-course.git"
              git push origin final-project
            '''
          }
        }
      }
    }
  }

  post {
    always {
      echo "Built & pushed: ${env.ECR_REPO}:${env.IMAGE_TAG}"
      echo "Updated values file: ${env.VALUES_FILE}"
    }
  }
}